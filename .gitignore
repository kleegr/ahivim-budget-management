node_modules/
.next/
out/
build/
.env
.env.local
.env*.local
*.tsbuildinfo
next-env.d.ts
.DS_Store
.vercel
coverage/

# Generated from pinned Tesseract packages before development and production builds
public/tesseract/

# Playwright end-to-end output (traces, screenshots, run marker)
test-results/
playwright-report/
.playwright/

# Never commit source workbooks or any real payroll data
*.xlsx
*.xls
*.xlsm
*.csv
/private-data/

# ...but the CSV export ROUTES are code, not data. Next.js names a route
# segment after its URL, so these directories literally end in ".csv" and the
# rule above was silently excluding them from every commit.
!src/app/api/exports/
!src/app/api/exports/**

# Build artifact, regenerated by scripts/embed-migrations.ts on every build
src/lib/db/migrations.generated.ts
tests/fixtures/ahivim-rows.json
tests/fixtures/workbook-source.xlsx
