# ---------------------------------------------------------------------------
# Ahivim Budget Management - environment template
# Copy to .env.local for local development. NEVER commit real values.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (pooled).
# On Vercel this is provided by the Neon integration. See docs/deployment.md
# for the exact variable name detected on this project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: direct (unpooled) connection, used for migrations if present.
DATABASE_URL_UNPOOLED=""

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Bootstrap administrator, created on first successful sign-in with these
# credentials while the users table is still empty.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Token required by POST /api/admin/migrate.
# If unset, the endpoint allows a single unauthenticated first-run bootstrap
# ONLY while the migrations ledger table does not yet exist. Setting this value
# disables that path entirely. See docs/deployment.md.
MIGRATION_TOKEN=""

# Maximum accepted upload size in bytes (default 20 MiB).
MAX_UPLOAD_BYTES="20971520"
