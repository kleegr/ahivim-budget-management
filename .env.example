# ---------------------------------------------------------------------------
# Ahivim Budget Management - environment template
# Copy to .env.local for local development. NEVER commit real values.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (pooled).
# On Vercel this is provided by the Neon integration. See docs/deployment.md
# for the exact variable name detected on this project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: direct (unpooled) connection, used for migrations if present.
DATABASE_URL_UNPOOLED=""

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Bootstrap administrator, created on the first successful sign-in with exactly
# these credentials, and only while the users table is still empty. Minimum
# password length is 10 characters. No credential is ever generated or logged.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Token accepted by POST /api/admin/migrate INSTEAD of an administrator
# session. Needed only for a database that has no administrator yet, or for
# automated deploys. There is no unauthenticated migration path.
# See docs/deployment.md.
MIGRATION_TOKEN=""

# Bearer token used by the scheduled sheet-sync endpoint. Vercel Cron sends
# Authorization: Bearer $CRON_SECRET. Use a separate random 32-byte secret.
CRON_SECRET=""

# Optional Google Sheets write-back. Share the configured Google Sheet with
# this service-account email as an editor. Without these values, the same UI
# button safely refreshes data from the sheet without writing to it.
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
# Alternative to the two fields above: raw or base64-encoded service-account JSON.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=""

# Maximum accepted upload size in bytes (default 20 MiB).
MAX_UPLOAD_BYTES="20971520"

# Private Vercel Blob store used by the PDF document library. Vercel supplies
# this after a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=""

# Maximum accepted PDF size in bytes (default 100 MiB, hard limit 500 MiB).
MAX_PDF_UPLOAD_BYTES="104857600"

# LOCAL DEVELOPMENT ONLY. host:port of a WebSocket-to-TCP bridge
# (npm run dev:ws-proxy), so the Neon driver can reach a local PostgreSQL.
# Never set this in production.
NEON_WS_PROXY=""
